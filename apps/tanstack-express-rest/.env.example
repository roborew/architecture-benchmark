# Copy to `.env` for a manual `docker compose up --build`.
# The rig allocates ports and passes these itself; these are just defaults.

# Host ports (API container listens on 4000, SPA on 80).
API_PORT=4010
SPA_PORT=3010

# URL the SPA is built against (must reach the API from the browser).
VITE_API_URL=http://localhost:4010

# Origin the API allows (this API reflects the origin, so it is informational).
CORS_ORIGIN=http://localhost:3010

# Resource caps (must match the experiment config for comparable runs).
APP_CPUS=2
APP_MEMORY_MB=2048
DB_CPUS=2
DB_MEMORY_MB=2048

COMPOSE_PROJECT_NAME=bench-tanstack-express-rest
