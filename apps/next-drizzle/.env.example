# Copy to `.env` for a manual `docker compose up --build`.
# The rig allocates ports and passes caps itself; these are just sane defaults.

# Host port the app is published on (container listens on 3000).
APP_PORT=3001

# Resource caps (must match the experiment config for comparable runs).
APP_CPUS=2
APP_MEMORY_MB=2048
DB_CPUS=2
DB_MEMORY_MB=2048

# Compose project name; the rig overrides this per run.
COMPOSE_PROJECT_NAME=bench-next-drizzle
