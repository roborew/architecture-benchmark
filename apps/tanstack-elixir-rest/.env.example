# Benchmark stack for tanstack-elixir-rest (SPA + Phoenix/Ecto API).
#
# This is documentation for manual `docker compose` use. The rig injects these
# names itself; no `.env` file is used during measured runs.

# ---- In-stack Postgres (never published to the host) ----------------------
POSTGRES_URL=postgresql://bench:bench@db:5432/bench
# The Phoenix app reads DATABASE_URL (config/runtime.exs, prod block). It is
# the same in-stack URL; the DB is reachable only on the Compose network.
DATABASE_URL=postgresql://bench:bench@db:5432/bench

# ---- Published host ports -------------------------------------------------
API_PORT=4016
SPA_PORT=3016

# ---- Resource caps (deploy.resources.limits) ------------------------------
APP_CPUS=2
APP_MEMORY_MB=2048
DB_CPUS=2
DB_MEMORY_MB=2048

# ---- SPA wiring -----------------------------------------------------------
# Baked into the SPA bundle at build time (the rig resolves the API port).
VITE_API_URL=http://localhost:4016
# Passed to the API for parity; the Phoenix CORS plug reflects the request
# Origin, so this value is not actually consulted.
CORS_ORIGIN=http://localhost:3016

# ---- Phoenix API runtime --------------------------------------------------
# BENCHMARK CONSTANT — a throwaway value for a local benchmark, not a secret.
# Prod refuses to boot without a SECRET_KEY_BASE (config/runtime.exs).
SECRET_KEY_BASE=o8Va/gFsnpiF2/slRuqI14Fp/zy+JgB5hjvryu3Uq9bpqY65pAYAsjw9VQIw97ucWaSlYlFKLBHloG8zCUO0+g==
# A `mix release` starts the endpoint only when this is set.
PHX_SERVER=true
PHX_HOST=localhost
PORT=4000
MIX_ENV=prod
LANG=C.UTF-8
